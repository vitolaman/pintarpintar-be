# Application runtime
NODE_ENV=development
JWT_ADMIN_KEY=pintar-pintar-local-development-change-me
JWT_EXPIRES=30d

# Host-side application connection values
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USERNAME=pintar_pintar
DB_PASSWORD=pintar_pintar_local
DB_DATABASE=pintar_pintar

# Compose PostgreSQL service values
# Set LOCAL_POSTGRES_IMAGE to staging/production's exact PostgreSQL image/tag when known.
LOCAL_POSTGRES_IMAGE=postgres:16-alpine
LOCAL_DB_PORT=5433
LOCAL_DB_USERNAME=pintar_pintar
LOCAL_DB_PASSWORD=pintar_pintar_local
LOCAL_DB_DATABASE=pintar_pintar
