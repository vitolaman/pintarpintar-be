# Application runtime
# JWT_ADMIN_KEY is required: the app refuses to start without it. Use a long
# random value (openssl rand -base64 48); changing it signs every user out.
NODE_ENV=development
JWT_ADMIN_KEY=pintar-pintar-local-development-change-me
JWT_EXPIRES=30d

# Host-side application connection values
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USERNAME=pintar_pintar
DB_PASSWORD=pintar_pintar_local
DB_DATABASE=pintar_pintar

# Local Redis used by the inherited template infrastructure
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Compose PostgreSQL service values
# Set LOCAL_POSTGRES_IMAGE to staging/production's exact PostgreSQL image/tag when known.
LOCAL_POSTGRES_IMAGE=postgres:16-alpine
LOCAL_DB_PORT=5433
LOCAL_DB_USERNAME=pintar_pintar
LOCAL_DB_PASSWORD=pintar_pintar_local
LOCAL_DB_DATABASE=pintar_pintar
LOCAL_REDIS_IMAGE=redis:7-alpine
LOCAL_REDIS_PORT=6379

# OpenTelemetry / Jaeger (OTLP)
OTEL_ENABLED=true
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=pintar-pintar-be
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# Optional: overrides OTEL_EXPORTER_OTLP_ENDPOINT for traces only.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_LOG_LEVEL=error

# Optional base64-encoded 32-byte key that encrypts payout account numbers (openssl rand -base64 32).
# Leave empty to store account numbers as plain text. Never change or remove it once accounts are encrypted.
PAYOUT_ACCOUNT_ENCRYPTION_KEY=

# S3-compatible storage for uploads (upload and file-asset modules)
AWS_S3_BUCKET_NAME=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
# Set to true only for path-style S3-compatible endpoints (for example a local S3 mock)
AWS_S3_FORCE_PATH_STYLE=

# Public base URL for images (CDN or public bucket URL); image *_url fields are null without it
ASSET_PUBLIC_BASE_URL=

# Duitku POP checkout. Sandbox: API base https://api-sandbox.duitku.com/api and
# status URL https://sandbox.duitku.com/webapi/api/merchant/transactionStatus.
# Production: https://api-prod.duitku.com/api and
# https://passport.duitku.com/webapi/api/merchant/transactionStatus.
# Paid checkout and the status check respond 503 until all six are set.
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_STATUS_URL=
# Duitku project merchant code and API key.
PAYMENT_GATEWAY_MERCHANT_KEY=
PAYMENT_GATEWAY_API_KEY=
# Public URL Duitku posts payment notifications to, e.g.
# https://api.pintarpintar.id/api/v1/payments/duitku/callback
PAYMENT_CALLBACK_URL=
# Frontend page the buyer returns to; `order_id` is appended.
PAYMENT_RETURN_URL=

# Automatic emails over SMTP (Poste). Until all six are set, emails wait in
# the queue instead of being sent. Port 465 uses TLS; any other port STARTTLS.
MAIL_HOST=
MAIL_PORT=587
# The mailbox the app logs in as, e.g. mail@pintarpintar.id
MAIL_USERNAME=
MAIL_PASSWORD=
# From header, e.g. Pintar Pintar <info@pintarpintar.id>
MAIL_SENDER=
# Frontend base URL for the links in emails, e.g. https://pintarpintar.id
FRONTEND_URL=

# Optional: which env file the app and the migration CLI read (default .env).
# ENV_FILE=.env.local
